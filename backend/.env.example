# Multi-DB AI POC - Environment Variables
CUSTOMER_DOMAIN=business_wire
AWS_REGION_NAME=us-east-1
DYNAMODB_TABLE_PREFIX=multidb_poc

# Aurora PostgreSQL (set by CDK or use local)
AURORA_SECRET_ARN=
AURORA_CLUSTER_ENDPOINT=localhost
AURORA_DB_NAME=multidb_poc

# ElastiCache (existing serverless Valkey)
ELASTICACHE_ENDPOINT=test-new-lahvej.serverless.use1.cache.amazonaws.com
ELASTICACHE_PORT=6379
CACHE_TTL_SECONDS=3600

# Neptune Analytics
NEPTUNE_GRAPH_ID=

# Bedrock
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CLAUDE_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
